{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plan name (e.g., Basic, Pro)"
    },
    "price": {
      "type": "number",
      "description": "Price per billing period"
    },
    "currency": {
      "type": "string",
      "default": "GBP",
      "description": "Currency code"
    },
    "interval": {
      "type": "string",
      "enum": [
        "month",
        "year"
      ],
      "default": "month",
      "description": "Billing interval"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features included"
    },
    "max_properties": {
      "type": "number",
      "description": "Maximum properties allowed (-1 for unlimited)"
    },
    "storage_mb": {
      "type": "number",
      "description": "Storage limit in MB"
    },
    "is_popular": {
      "type": "boolean",
      "default": false,
      "description": "Mark as popular plan"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether plan is available for selection"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe Price ID for this plan"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name",
    "price",
    "max_properties",
    "storage_mb"
  ]
}